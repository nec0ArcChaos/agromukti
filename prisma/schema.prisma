// AGROMUKTI - Sistem Informasi Terpadu Desa Argamukti
// KKM Kelompok 45 - Universitas Muhammadiyah Cirebon 2026
//
// KONVENSI WAJIB (jangan dilanggar tanpa diskusi):
//  1. Nominal uang = Int, satuan rupiah utuh. TIDAK PERNAH Float.
//  2. Berat        = Decimal(10,2), satuan kilogram.
//  3. TIDAK ADA enum Prisma. Semua status/kategori = String, divalidasi Zod.
//     Alasan: SQLite tidak mendukung enum, menjaga pintu darurat "portabel
//     tanpa hosting" yang dijanjikan proposal tetap terbuka.
//  4. Data transaksi TIDAK PERNAH dihapus. Hanya dibatalkan (status VOID)
//     dengan mutasi pembalik. Buku besar hanya bertambah.
//
// ALUR NILAI (berbeda dari kebanyakan bank sampah konvensional):
//  Setoran HANYA mencatat berat saat nasabah menyetor - BELUM ada nilai
//  rupiah, karena bank sampah ini tidak menetapkan harga sendiri. Nilai
//  baru muncul saat pengepul benar-benar datang dan membayar (lihat
//  PengambilanPengepul), lalu dibagi proporsional ke tiap nasabah menurut
//  berat setorannya. Konsekuensinya: kas SELALU cukup menutupi kredit yang
//  baru saja dituliskan, karena kredit hanya terjadi bersamaan dengan uang
//  masuk dari pengepul - tidak pernah mendahuluinya.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// DOMAIN: DATA INDUK
// ============================================================

/// Operator dan admin sistem. Nasabah TIDAK punya akun.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  nama         String
  /// ADMIN | OPERATOR_SAMPAH | OPERATOR_ORGANIK | OPERATOR_TANI | KEPALA_DESA
  role         String   @default("OPERATOR_SAMPAH")
  aktif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  setoranDibuat      Setoran[]              @relation("SetoranOperator")
  pengambilanDibuat  PengambilanPengepul[]  @relation("PengambilanOperator")
  penarikanDiajukan  Penarikan[]            @relation("PenarikanPengaju")
  penarikanDisetujui Penarikan[]            @relation("PenarikanPenyetuju")
  auditLog           AuditLog[]

  @@index([aktif])
}

/// Warga penyetor sampah anorganik.
model Nasabah {
  id            String   @id @default(cuid())
  /// Identitas warga - nama, alamat, dusun, dan kontak ada di sana.
  wargaId       String
  /// Format AGM-0001, dibangkitkan lewat tabel Sequence.
  kode          String   @unique
  tanggalDaftar DateTime @default(now())
  /// AKTIF | NONAKTIF
  status        String   @default("AKTIF")
  /// CACHE, bukan sumber kebenaran. Kebenaran ada di MutasiTabungan.
  /// Wajib ada perintah rekonsiliasi yang menghitung ulang dari mutasi.
  saldo         Int      @default(0)
  catatan       String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  warga     Warga            @relation(fields: [wargaId], references: [id])
  setoran   Setoran[]
  mutasi    MutasiTabungan[]
  penarikan Penarikan[]

  @@index([wargaId])
  @@index([status])
}

/// Label ringan kategori sampah anorganik (plastik, kertas, logam, dst).
/// Murni untuk komposisi laporan - TIDAK ada harga di sini. Harga
/// ditentukan pengepul saat pengambilan, bukan oleh bank sampah.
model KategoriSampah {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setoran Setoran[]

  @@index([aktif])
}

/// Pengepul yang membeli sampah anorganik terkumpul.
model Pengepul {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  noHp      String?
  alamat    String?
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pengambilan PengambilanPengepul[]

  @@index([aktif])
}

/// Konfigurasi tunggal sistem. Selalu tepat satu baris (id = "SINGLETON").
model Pengaturan {
  id               String   @id @default("SINGLETON")
  namaBankSampah   String   @default("Bank Sampah Desa Argamukti")
  alamat           String?  @db.Text
  desa             String   @default("Argamukti")
  kecamatan        String   @default("Argapura")
  kabupaten        String   @default("Majalengka")
  kepalaDesa       String?
  ketuaBankSampah  String?
  /// Batas minimal satu kali penarikan, rupiah.
  minimalPenarikan Int      @default(10000)
  /// Saldo minimal yang harus tersisa di rekening nasabah.
  saldoMinimum     Int      @default(0)
  updatedAt        DateTime @updatedAt
}

// ============================================================
// DOMAIN: SETORAN, PENGAMBILAN PENGEPUL & TABUNGAN
// ============================================================

/// Setoran sampah anorganik dari nasabah. HANYA mencatat berat - belum
/// ada nilai rupiah, sampai pengepul benar-benar membayar (lihat status).
model Setoran {
  id               String    @id @default(cuid())
  /// Format ST-202608-0001, dibangkitkan lewat tabel Sequence.
  nomor            String    @unique
  nasabahId        String
  kategoriSampahId String?
  tanggal          DateTime  @default(now())
  beratKg          Decimal   @db.Decimal(10, 2)
  /// MENUNGGU (masih di bank sampah) | DIPROSES (sudah dibeli pengepul,
  /// nasabah sudah dikredit) | VOID (dibatalkan)
  status           String    @default("MENUNGGU")
  /// Bagian dari totalNilai pengambilan pengepul, dibagi proporsional
  /// menurut berat. Diisi HANYA saat status berubah menjadi DIPROSES.
  nilaiAlokasi     Int?
  alasanBatal      String?   @db.Text
  catatan          String?   @db.Text
  operatorId       String
  pengambilanId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  nasabah        Nasabah              @relation(fields: [nasabahId], references: [id])
  kategoriSampah KategoriSampah?      @relation(fields: [kategoriSampahId], references: [id])
  operator       User                 @relation("SetoranOperator", fields: [operatorId], references: [id])
  pengambilan    PengambilanPengepul? @relation(fields: [pengambilanId], references: [id])

  @@index([nasabahId, tanggal])
  @@index([status])
  @@index([tanggal])
  @@index([pengambilanId])
}

/// Satu kedatangan pengepul yang membeli borongan sampah dari banyak
/// nasabah sekaligus. Nilai totalNilai (yang BENAR-BENAR dibayarkan
/// pengepul) dibagi proporsional ke tiap Setoran yang diikutsertakan,
/// menurut porsi beratnya - lihat pengambilan.service.ts untuk algoritma
/// pembagian yang menjamin jumlah alokasi selalu tepat sama dengan
/// totalNilai (tidak meleset karena pembulatan).
model PengambilanPengepul {
  id           String   @id @default(cuid())
  /// Format PP-202608-0001.
  nomor        String   @unique
  pengepulId   String
  tanggal      DateTime @default(now())
  totalBeratKg Decimal  @db.Decimal(10, 2)
  totalNilai   Int
  /// POSTED | VOID
  status       String   @default("POSTED")
  alasanBatal  String?  @db.Text
  catatan      String?  @db.Text
  operatorId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pengepul Pengepul  @relation(fields: [pengepulId], references: [id])
  operator User      @relation("PengambilanOperator", fields: [operatorId], references: [id])
  setoran  Setoran[]

  @@index([pengepulId, tanggal])
  @@index([tanggal])
  @@index([status])
}

/// BUKU BESAR SALDO NASABAH - sumber kebenaran tunggal.
/// Hanya bertambah; tidak pernah diubah atau dihapus.
model MutasiTabungan {
  id           String   @id @default(cuid())
  nasabahId    String
  tanggal      DateTime @default(now())
  /// PENGAMBILAN_PENGEPUL | PENARIKAN | KOREKSI | PEMBATALAN
  jenis        String
  /// Mengurangi saldo (penarikan, pembatalan).
  debit        Int      @default(0)
  /// Menambah saldo (hasil setoran yang sudah dibeli pengepul).
  kredit       Int      @default(0)
  /// Saldo berjalan setelah mutasi ini. Memudahkan cetak buku tabungan.
  saldoSesudah Int
  /// PENGAMBILAN | PENARIKAN - menunjuk dokumen sumber.
  refTipe      String?
  refId        String?
  keterangan   String?  @db.Text
  createdAt    DateTime @default(now())

  nasabah Nasabah @relation(fields: [nasabahId], references: [id])

  @@index([nasabahId, tanggal])
  @@index([refTipe, refId])
}

/// Pengajuan dan pencairan saldo tabungan.
model Penarikan {
  id            String    @id @default(cuid())
  /// Format TR-202608-0001.
  nomor         String    @unique
  nasabahId     String
  tanggal       DateTime  @default(now())
  jumlah        Int
  /// TUNAI | TRANSFER | SEMBAKO
  metode        String    @default("TUNAI")
  /// PENDING | DISETUJUI | DITOLAK
  status        String    @default("PENDING")
  alasanTolak   String?   @db.Text
  tanggalCair   DateTime?
  diajukanOleh  String
  disetujuiOleh String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  nasabah   Nasabah @relation(fields: [nasabahId], references: [id])
  pengaju   User    @relation("PenarikanPengaju", fields: [diajukanOleh], references: [id])
  penyetuju User?   @relation("PenarikanPenyetuju", fields: [disetujuiOleh], references: [id])

  @@index([nasabahId, tanggal])
  @@index([status])
}

// ============================================================
// DOMAIN: KAS
// ============================================================

/// Buku besar kas lembaga.
model MutasiKas {
  id           String   @id @default(cuid())
  tanggal      DateTime @default(now())
  /// MASUK | KELUAR
  arah         String
  /// PENGEPUL | PENARIKAN_NASABAH | MODAL_AWAL | OPERASIONAL | HIBAH | LAINNYA
  kategori     String
  jumlah       Int
  saldoSesudah Int
  /// PENGAMBILAN | PENARIKAN - menunjuk dokumen sumber bila ada.
  refTipe      String?
  refId        String?
  keterangan   String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([tanggal])
  @@index([kategori])
  @@index([refTipe, refId])
}

// ============================================================
// DOMAIN: SISTEM
// ============================================================

/// Jejak seluruh perubahan data. Wajib untuk sistem yang memegang uang.
model AuditLog {
  id       String   @id @default(cuid())
  userId   String?
  /// CREATE | UPDATE | VOID | LOGIN | APPROVE | REJECT
  aksi     String
  tabel    String
  recordId String?
  dataLama String?  @db.Text
  dataBaru String?  @db.Text
  ip       String?
  waktu    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([tabel, recordId])
  @@index([waktu])
}

/// Penomoran dokumen anti-tabrakan.
/// JANGAN pakai COUNT(*) + 1 - dua operator yang menyimpan bersamaan akan
/// mendapat nomor kembar. Nomor diambil di dalam transaksi yang sama.
model Sequence {
  /// SETORAN | PENARIKAN | PENGAMBILAN | NASABAH | PETANI | PERMINTAAN | DISTRIBUSI | PRODUKSI
  tipe          String
  /// YYYYMM, atau "-" untuk sequence yang tidak direset per periode.
  periode       String
  nomorTerakhir Int    @default(0)

  @@id([tipe, periode])
}

// ============================================================
// DOMAIN: IDENTITAS WARGA (dipakai lintas pilar)
// ============================================================

/// Identitas tunggal warga Desa Argamukti.
///
/// Seorang warga bisa sekaligus menjadi Nasabah bank sampah DAN Petani -
/// keduanya profil yang menunjuk ke baris Warga yang sama, sehingga tidak
/// ada data nama/alamat yang terduplikasi antar pilar dan laporan
/// kontribusi lintas pilar menjadi mungkin.
///
/// CATATAN PRIVASI: `nik` sengaja OPSIONAL. Skema PHP lama menjadikannya
/// NOT NULL UNIQUE dan `api.php` mengekspos seluruh NIK petani tanpa
/// autentikasi. NIK adalah data pribadi di bawah UU PDP - hanya diisi bila
/// benar-benar diperlukan, dan tidak pernah dikembalikan endpoint publik.
model Warga {
  id        String   @id @default(cuid())
  nik       String?  @unique
  nama      String
  alamat    String?  @db.Text
  /// Lima dusun di Desa Argamukti.
  dusun     String?
  rt        String?
  rw        String?
  noHp      String?
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nasabah Nasabah[]
  petani  Petani[]

  @@index([nama])
  @@index([dusun])
  @@index([aktif])
}

// ============================================================
// PILAR: PERTANIAN & DISTRIBUSI PUPUK  (proker Ayu Rianti)
// ============================================================

/// Profil petani. Identitasnya ada di Warga.
model Petani {
  id           String   @id @default(cuid())
  wargaId      String
  /// Format TN-0001.
  kode         String   @unique
  kelompokTani String?
  /// AKTIF | NONAKTIF
  status       String   @default("AKTIF")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  warga      Warga             @relation(fields: [wargaId], references: [id])
  lahan      Lahan[]
  panen      Panen[]
  permintaan PermintaanPupuk[]

  @@index([wargaId])
  @@index([status])
}

/// Komoditas hortikultura yang diusahakan warga.
model Komoditas {
  id              String   @id @default(cuid())
  kode            String   @unique
  nama            String
  deskripsi       String?  @db.Text
  /// Dosis pupuk anjuran per hektare, dipakai menghitung usulan alokasi.
  dosisPupukPerHa Decimal  @default(5) @db.Decimal(10, 2)
  aktif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lahan Lahan[]
  panen Panen[]

  @@index([aktif])
}

/// Lahan garapan milik/dikelola petani.
model Lahan {
  id          String   @id @default(cuid())
  petaniId    String
  komoditasId String
  luas        Decimal  @db.Decimal(12, 2)
  /// M2 | HA
  satuan      String   @default("M2")
  lokasi      String?  @db.Text
  /// AKTIF | NONAKTIF
  status      String   @default("AKTIF")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  petani    Petani    @relation(fields: [petaniId], references: [id])
  komoditas Komoditas @relation(fields: [komoditasId], references: [id])

  @@index([petaniId])
  @@index([komoditasId])
  @@index([status])
}

/// Pencatatan hasil panen per komoditas.
model Panen {
  id           String   @id @default(cuid())
  petaniId     String
  komoditasId  String
  jumlahPanen  Decimal  @db.Decimal(12, 2)
  /// KG | KUINTAL | TON
  satuan       String   @default("KG")
  tanggalPanen DateTime
  keterangan   String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  petani    Petani    @relation(fields: [petaniId], references: [id])
  komoditas Komoditas @relation(fields: [komoditasId], references: [id])

  @@index([petaniId, tanggalPanen])
  @@index([komoditasId])
  @@index([tanggalPanen])
}

/// Produk pupuk yang disimpan dan didistribusikan.
/// Stoknya diisi oleh hasil produksi pilar organik (lihat ProduksiPupuk) -
/// inilah titik sambung ekonomi sirkular antar pilar.
model ProdukPupuk {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  /// KOMPOS_PADAT | PUPUK_CAIR
  jenis     String   @default("KOMPOS_PADAT")
  deskripsi String?  @db.Text
  harga     Int      @default(0)
  /// KG | LITER | KARUNG
  satuan    String   @default("KG")
  /// CACHE. Kebenaran ada di MutasiStokPupuk.
  stok      Decimal  @default(0) @db.Decimal(12, 2)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mutasiStok       MutasiStokPupuk[]
  permintaanDetail PermintaanPupukDetail[]
  distribusiDetail DistribusiPupukDetail[]

  @@index([aktif])
}

/// Buku besar stok pupuk. Menggantikan tabel `stok_pupuk`, `mutasi_stok`
/// (proker Ayu) dan `inventaris` (proker Bima) yang sebelumnya terpisah
/// dan saling menduplikasi angka stok yang sama.
model MutasiStokPupuk {
  id            String   @id @default(cuid())
  produkPupukId String
  tanggal       DateTime @default(now())
  /// MASUK | KELUAR | PENYESUAIAN
  arah          String
  jumlah        Decimal  @db.Decimal(12, 2)
  /// PRODUKSI | DISTRIBUSI | PENYESUAIAN | SALDO_AWAL
  refTipe       String?
  refId         String?
  sumber        String?
  keterangan    String?  @db.Text
  createdAt     DateTime @default(now())

  produkPupuk ProdukPupuk @relation(fields: [produkPupukId], references: [id])

  @@index([produkPupukId, tanggal])
  @@index([refTipe, refId])
}

/// Pengajuan pupuk oleh petani (bisa lewat portal warga tanpa login).
model PermintaanPupuk {
  id          String   @id @default(cuid())
  /// Format PMT-202609-0001.
  nomor       String   @unique
  petaniId    String
  tanggal     DateTime @default(now())
  /// DIAJUKAN | DIPROSES | DISETUJUI | DITOLAK | SELESAI
  status      String   @default("DIAJUKAN")
  alasanTolak String?  @db.Text
  keterangan  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  petani     Petani                  @relation(fields: [petaniId], references: [id])
  detail     PermintaanPupukDetail[]
  distribusi DistribusiPupuk[]

  @@index([petaniId, tanggal])
  @@index([status])
}

model PermintaanPupukDetail {
  id            String  @id @default(cuid())
  permintaanId  String
  produkPupukId String
  jumlah        Decimal @db.Decimal(12, 2)
  satuan        String  @default("KG")

  permintaan  PermintaanPupuk @relation(fields: [permintaanId], references: [id], onDelete: Cascade)
  produkPupuk ProdukPupuk     @relation(fields: [produkPupukId], references: [id])

  @@index([permintaanId])
}

/// Realisasi penyaluran pupuk atas sebuah permintaan yang disetujui.
model DistribusiPupuk {
  id                String   @id @default(cuid())
  /// Format DST-202609-0001.
  nomor             String   @unique
  permintaanId      String
  tanggalDistribusi DateTime @default(now())
  /// DIPROSES | DIKIRIM | DITERIMA | DIBATALKAN
  status            String   @default("DIPROSES")
  keterangan        String?  @db.Text
  operatorId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  permintaan PermintaanPupuk         @relation(fields: [permintaanId], references: [id])
  detail     DistribusiPupukDetail[]

  @@index([permintaanId])
  @@index([status])
  @@index([tanggalDistribusi])
}

model DistribusiPupukDetail {
  id            String  @id @default(cuid())
  distribusiId  String
  produkPupukId String
  jumlah        Decimal @db.Decimal(12, 2)
  satuan        String  @default("KG")

  distribusi  DistribusiPupuk @relation(fields: [distribusiId], references: [id], onDelete: Cascade)
  produkPupuk ProdukPupuk     @relation(fields: [produkPupukId], references: [id])

  @@index([distribusiId])
}

/// Artikel / tips pertanian untuk portal publik.
model Artikel {
  id               String   @id @default(cuid())
  judul            String
  konten           String   @db.Text
  gambar           String?
  kategori         String?
  tanggalPublikasi DateTime @default(now())
  terbit           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([terbit, tanggalPublikasi])
}

// ============================================================
// PILAR: SAMPAH ORGANIK & PRODUKSI PUPUK  (proker Bima)
//
// CATATAN: skema di bawah adalah REKONSTRUKSI dari cara aplikasi AgroMukti
// meng-query database `db_prokerkkm` milik Bima (kkm_buat_pupuk.php,
// kkm_umkm.php). Berkas asli belum tersedia, sehingga kolom yang tidak
// pernah disentuh AgroMukti tidak terlihat dari sini dan perlu
// dikonfirmasi ke penyusunnya.
//
// Perbedaan yang sengaja diambil dari aslinya: `jumlahsampahorganik` di
// sistem lama hanya SATU BARIS penghitung yang di-UPDATE langsung,
// sehingga riwayatnya hilang dan angkanya tidak bisa diaudit. Di sini
// diganti buku besar mutasi - pola yang sama dengan bank sampah.
// ============================================================

/// Buku besar stok bahan baku sampah organik.
model MutasiSampahOrganik {
  id         String   @id @default(cuid())
  tanggal    DateTime @default(now())
  /// MASUK (setoran warga) | KELUAR (dipakai produksi) | KOREKSI
  arah       String
  beratKg    Decimal  @db.Decimal(12, 2)
  /// Warga penyetor, bila setoran berasal dari warga tertentu.
  wargaId    String?
  /// SETORAN | PRODUKSI | KOREKSI
  refTipe    String?
  refId      String?
  sumber     String?
  keterangan String?  @db.Text
  operatorId String?
  createdAt  DateTime @default(now())

  @@index([tanggal])
  @@index([arah])
  @@index([refTipe, refId])
}

/// Satu siklus produksi pupuk dari sampah organik.
model ProduksiPupuk {
  id                  String    @id @default(cuid())
  /// Format PRD-202609-0001.
  kode                String    @unique
  tanggalMulai        DateTime
  estimasiSelesai     DateTime?
  tanggalSelesai      DateTime?
  beratSampahOrganik  Decimal   @db.Decimal(12, 2)
  estimasiPupukCair   Decimal   @default(0) @db.Decimal(12, 2)
  estimasiPupukKasar  Decimal   @default(0) @db.Decimal(12, 2)
  pupukCairAktual     Decimal?  @db.Decimal(12, 2)
  pupukKasarAktual    Decimal?  @db.Decimal(12, 2)
  /// DIHITUNG SISTEM saat panen, tidak pernah diinput.
  rendemenPersen      Decimal?  @db.Decimal(5, 2)
  /// PROSES | SELESAI | GAGAL
  status              String    @default("PROSES")
  keterangan          String?   @db.Text
  operatorId          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([tanggalMulai])
}

/// Produk UMKM desa (mis. Wajik Tomat) - proker Bima.
model ProdukUmkm {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  kategori  String?
  deskripsi String?  @db.Text
  harga     Int      @default(0)
  stok      Decimal  @default(0) @db.Decimal(12, 2)
  satuan    String   @default("PCS")
  foto      String?
  /// TERSEDIA | HABIS | NONAKTIF
  status    String   @default("TERSEDIA")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
